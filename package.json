    "esbuild": "^0.25.10",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.3",
    "buffer": "^6.0.3",
